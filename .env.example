# ID da pasta do Drive (o trecho depois de /folders/ na URL)
GOOGLE_DRIVE_FOLDER_ID=cole_o_id_da_pasta
# Credenciais OAuth 2.0 de um cliente do tipo "Aplicativo da Web".
GOOGLE_CLIENT_ID=cole_o_client_id
GOOGLE_CLIENT_SECRET=cole_o_client_secret
# Gere em http://localhost:3001/api/google-auth
GOOGLE_REFRESH_TOKEN=cole_o_refresh_token

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/foto-convidado?retryWrites=true&w=majority

# Autenticação
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d
# E-mail que receberá role ADMIN no cadastro
ADMIN_EMAIL=seu-email@exemplo.com

PORT=3001
# URL pública (sem barra no final)
# PUBLIC_URL=https://seu-dominio.com

# Plataforma
# Produto único: cada pagamento libera 90 dias (preço em centavos)
ACCESS_DURATION_DAYS=90
ACCESS_PRICE_CENTS=5000
ACCESS_MAX_GALLERIES=1
ACCESS_MAX_STORAGE_BYTES=5368709120
# Dias que a galeria pública permanece visível após expiração da assinatura
PUBLIC_GALLERY_GRACE_DAYS=30

# Mercado Pago Checkout Pro
# Nunca exponha estas credenciais no frontend.
MERCADOPAGO_ACCESS_TOKEN=cole_o_access_token
MERCADOPAGO_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_webhook
# Use true apenas com credenciais e compradores de teste.
MERCADOPAGO_USE_SANDBOX=true
