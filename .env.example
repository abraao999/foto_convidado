# Cloudflare R2 (armazenamento das fotos)
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=seu_bucket
R2_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/foto-convidado?retryWrites=true&w=majority

# Autenticação
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=seu-email@exemplo.com

PORT=3001
# PUBLIC_URL=https://seu-dominio.com

# Plataforma
ACCESS_DURATION_DAYS=90
ACCESS_PRICE_CENTS=5000
ACCESS_MAX_GALLERIES=1
ACCESS_MAX_STORAGE_BYTES=5368709120
UPLOAD_MAX_PHOTO_BYTES=26214400
# 2 MB por pedaço (limite de body da Vercel)
UPLOAD_CHUNK_BYTES=2097152
PUBLIC_GALLERY_GRACE_DAYS=30

# Mercado Pago Checkout Pro
MERCADOPAGO_ACCESS_TOKEN=cole_o_access_token
MERCADOPAGO_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_webhook
MERCADOPAGO_USE_SANDBOX=true
